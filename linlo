perform_search() {
    local search_name="$1"
    local search_mode="$2"
    local pattern
    local found=0
    local result

    if ! command -v find >/dev/null 2>&1; then
        printf "Linlo requires the 'find' command.\n" >&2
        return 1
    fi

    case "$search_mode" in
        exact)
            pattern="$search_name"
            ;;
        *)
            pattern="*$search_name*"
            ;;
    esac

    clear
    printf '%s\n' 'LINLO — SEARCH'
    printf '%s\n' '=============='
    filesystem_text
    printf 'Search: %s\n\n' "$search_name"

    while IFS= read -r result; do
        printf '%s\n' "$result"
        found=$((found + 1))
    done < <(
        case "$search_mode" in
            directories)
                find / -type d -iname "$pattern" 2>/dev/null
                ;;
            files)
                find / -type f -iname "$pattern" 2>/dev/null
                ;;
            *)
                find / -iname "$pattern" 2>/dev/null
                ;;
        esac
    )

    printf '\n========================\n'
    printf 'Search complete: %s result(s).\n' "$found"
    read -rp "Press ENTER to continue."
}

search_menu() {
    local choice
    local search_name

    clear
    printf '%s\n' 'What would you like to find?'
    printf '\n'
    printf '%s\n' 'Press ENTER. Search for everything'
    printf '%s\n' '1. Search by name'
    printf '%s\n' '2. Search for an exact name'
    printf '%s\n' '3. Search directories only'
    printf '%s\n' '4. Search files only'
    printf '%s\n' '5. Return to menu'
    printf '\n'

    read -rp 'Select an option: ' choice

    case "$choice" in
        ""|1|2|3|4)
            read -rp 'What would you like to find? ' search_name
            [[ -z "$search_name" ]] && return

            case "$choice" in
                2) perform_search "$search_name" exact ;;
                3) perform_search "$search_name" directories ;;
                4) perform_search "$search_name" files ;;
                *) perform_search "$search_name" everything ;;
            esac
            ;;
        5)
            return
            ;;
        *)
            printf 'Invalid option.\n'
            sleep 1
            ;;
    esac
}

main_menu() {
    local choice

    while true; do
        clear
        printf '%s\n' 'LINLO — A SIMPLE FILE FINDER'
        printf '%s\n' '============================'
        filesystem_text
        printf '\n'
        printf '%s\n' '1. Find something'
        printf '%s\n' '2. License and credits'
        printf '%s\n' '3. System information'
        printf '%s\n' '4. Exit'
        printf '\n'

        read -rp 'Select an option: ' choice

        case "$choice" in
            1) search_menu ;;
            2) show_license ;;
            3)
                clear
                show_os
                read -rp 'Press ENTER to return to the main menu.'
                ;;
            4)
                printf 'Thank you for using Linlo!\n'
                exit 0
                ;;
            *)
                printf 'Invalid option.\n'
                sleep 1
                ;;
        esac
    done
}

detect_os

