#!/usr/bin/env bash

LINLO_VERSION="1.1"
LINLO_NAME="Linlo"

detect_os() {
    OS_KERNEL="$(uname -s 2>/dev/null || printf 'Unknown')"
    OS_NAME="Unknown"
    OS_DISPLAY="Unknown"

    case "$OS_KERNEL" in
        Linux)
            OS_NAME="Linux"
            if [[ -r /etc/os-release ]]; then
                OS_DISPLAY="$(
                    . /etc/os-release
                    printf '%s' "${PRETTY_NAME:-Linux}"
                )"
            else
                OS_DISPLAY="Linux"
            fi
            ;;
        FreeBSD)
            OS_NAME="FreeBSD"
            OS_DISPLAY="FreeBSD"
            ;;
        Darwin)
            OS_NAME="macOS"
            OS_DISPLAY="macOS"
            ;;
        *)
            OS_NAME="$OS_KERNEL"
            OS_DISPLAY="$OS_KERNEL"
            ;;
    esac
}

filesystem_text() {
    case "$OS_NAME" in
        Linux)
            if [[ "$OS_DISPLAY" == "Linux" ]]; then
                printf 'Linlo searches your entire Linux filesystem.\n'
            else
                printf 'Linlo searches your entire %s filesystem.\n' "$OS_DISPLAY"
            fi
            ;;
        FreeBSD)
            printf 'Linlo searches your entire FreeBSD filesystem.\n'
            ;;
        macOS)
            printf 'Linlo searches your macOS filesystem.\n'
            ;;
        *)
            printf 'Linlo searches your filesystem on %s.\n' "$OS_DISPLAY"
            ;;
    esac
}

show_version() {
    printf '%s %s\n' "$LINLO_NAME" "$LINLO_VERSION"
}

show_os() {
    printf 'Linlo system information\n'
    printf '%s\n' '========================'
    printf 'Operating system: %s\n' "$OS_DISPLAY"
    printf 'Kernel: %s\n' "$OS_KERNEL"

    if command -v find >/dev/null 2>&1; then
        printf 'Dependency: find is available.\n'
    else
        printf 'Dependency: find is missing.\n'
        printf 'Install the findutils package for your system.\n'
    fi
}

